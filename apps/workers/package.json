{
  "name": "@curios/workers",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "start": "node --env-file-if-exists=../../.env --import tsx src/main.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "group:backfill": "tsx --env-file=../../.env src/grouping/backfill.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1141.0",
    "@curios/billing": "workspace:*",
    "@curios/core": "workspace:*",
    "@curios/db": "workspace:*",
    "@curios/embeddings": "workspace:*",
    "@curios/gateway": "workspace:*",
    "@curios/storage": "workspace:*",
    "@prisma/client": "^6.1.0",
    "@sentry/node": "10.76.2",
    "bullmq": "^5.34.0",
    "cheerio": "^1.0.0",
    "ioredis": "^5.4.2",
    "nodemailer": "^9.1.1",
    "pino": "^9.6.0",
    "undici": "^7.30.2",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@types/nodemailer": "^8.0.1",
    "@types/web-push": "3.6.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
