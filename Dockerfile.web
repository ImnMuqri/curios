# The web app (apps/web), at curios.my. Built here, on Linux: a Windows `next build` loses
# the font preloads (devDocs/OPERATIONS.md), so production is never built from a Windows checkout.
FROM node:22-bookworm-slim AS build

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.15.9

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch --frozen-lockfile

COPY . .
RUN pnpm install --frozen-lockfile --offline \
  && pnpm --filter @curios/db exec prisma generate

# Written into the browser's JavaScript at build time, so they must be known now, not at start.
# Railway passes a service variable of the same name as the build argument.
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_TELEMETRY_DISABLED=1 \
    NEXT_STANDALONE=1

RUN pnpm --filter @curios/web build

# What runs: the standalone server and only the files it needs (next.config.ts), not the whole
# workspace's node_modules. Static assets and public/ are not part of the traced output, so they
# are copied beside it, where server.js looks for them.
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=build /app/apps/web/.next/standalone ./
COPY --from=build /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=build /app/apps/web/public ./apps/web/public

# HOSTNAME: server.js binds to it, and Docker sets it to the container's id, which would leave the
# server unreachable from outside the container. PORT is Railway's.
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1 \
    HOSTNAME=0.0.0.0
WORKDIR /app/apps/web
# node itself as the container's process, so a deploy's SIGTERM reaches the server.
CMD ["node", "server.js"]
