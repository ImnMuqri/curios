# The admin app (apps/admin), at admin.curios.my. Built on Linux, as the web app is.
# Its own service and address: owners are never served admin code (devDocs/OPERATIONS.md, Admin).
FROM node:22-bookworm-slim

RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.15.9

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch --frozen-lockfile

COPY . .
RUN pnpm install --frozen-lockfile --offline \
  && pnpm --filter @curios/db exec prisma generate

# Written into the browser's JavaScript at build time, so they must be known now, not at start.
# Railway passes a service variable of the same name as the build argument.
ARG NEXT_PUBLIC_ADMIN_API_URL
ARG NEXT_PUBLIC_SENTRY_DSN
ENV NEXT_PUBLIC_ADMIN_API_URL=$NEXT_PUBLIC_ADMIN_API_URL \
    NEXT_PUBLIC_SENTRY_DSN=$NEXT_PUBLIC_SENTRY_DSN \
    NEXT_TELEMETRY_DISABLED=1

RUN pnpm --filter @curios/admin build

ENV NODE_ENV=production
WORKDIR /app/apps/admin
# `next start` listens on $PORT, which Railway sets.
CMD ["node", "node_modules/next/dist/bin/next", "start"]
