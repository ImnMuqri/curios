# The API and the workers: one image, two Railway services (devDocs/OPERATIONS.md, Deploying on Railway),
# told apart by their start commands. Neither has a build step: they run their TypeScript through
# tsx, as `pnpm dev` does, without watching.
FROM node:22-bookworm-slim

# OpenSSL for Prisma's query engine; certificates for the HTTPS calls (CHIP, Anthropic, OpenAI, R2).
RUN apt-get update \
  && apt-get install -y --no-install-recommends openssl ca-certificates \
  && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9.15.9

WORKDIR /app

# The lockfile alone first, so a code change reuses the downloaded packages.
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
RUN pnpm fetch --frozen-lockfile

COPY . .
# Before NODE_ENV=production: devDependencies hold tsx and the Prisma CLI, which this image runs.
RUN pnpm install --frozen-lockfile --offline \
  && pnpm --filter @curios/db exec prisma generate

ENV NODE_ENV=production
# node itself, not pnpm, as the container's process: a deploy's SIGTERM must reach the app, which
# closes its connections and finishes what is in flight (apps/api/src/server.ts, apps/workers/src/main.ts).
# The API by default; the workers service sets its start command to apps/workers/src/main.ts.
CMD ["node", "--import", "tsx", "apps/api/src/server.ts"]
