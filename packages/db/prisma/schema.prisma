generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageMode {
  PERSONAL
  BUSINESS
}

enum AuthProvider {
  GOOGLE
}

enum FactCategory {
  PRICE
  HOURS
  LOCATION
  POLICY
  PRODUCT
  PERSON
  MISC
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Who a fact came from. EXTRACTED facts belong to the Ingestion that wrote
/// them and go when it is removed. OWNER facts were typed or edited by the
/// owner and survive any source's removal. UNTRACKED facts predate slice 14,
/// when no fact recorded its ingestion; they are removed one at a time.
enum FactOrigin {
  EXTRACTED
  OWNER
  UNTRACKED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

enum AuthTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BillingPlan {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  PAID
}

enum TileSize {
  SMALL
  WIDE
  TALL
  BIG
}

enum PageStyle {
  SOFT
  CONTRAST
}

enum HeadingFont {
  JAKARTA
  BRICOLAGE
  FRAUNCES
  SPACE_GROTESK
  DM_SERIF
  OUTFIT
}

model Account {
  id              String               @id @default(cuid())
  email           String               @unique
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime             @default(now())
  identities      AuthIdentity[]
  pages           Page[]
  sessions        Session[]
  password        PasswordCredential?
  authTokens      AuthToken[]
}

model AuthIdentity {
  id             String       @id @default(cuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  email          String
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([accountId])
}

model Page {
  id            String         @id @default(cuid())
  accountId     String
  account       Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  handle        String         @unique
  skeleton      String         @unique
  mode          PageMode       @default(BUSINESS)
  displayName   String
  bio           String?
  language      String         @default("en")
  published     Boolean        @default(false)
  /// Paid through this instant. Null means never paid. A one-off Billplz bill
  /// extends it; there is no subscription to activate, suspend or reconcile,
  /// because a one-off bill has no lifecycle to model. Lapsed is a comparison.
  paidUntil     DateTime?
  /// Leads ever captured, and never decremented. A counter rather than
  /// count(Lead) because slice 5 gave owners a lead delete -- counting rows
  /// would let somebody delete their three trial leads and get three more.
  leadsCaptured Int            @default(0)
  /// When the owner spent their one trial reset. Null means unused, and the
  /// reset's conditional update requires null -- so a second click changes no
  /// rows rather than granting a second trial.
  trialResetAt  DateTime?
  /// The paidUntil this owner was last reminded about. Renewing moves paidUntil,
  /// which makes the next period eligible by itself: no reminders table, and no
  /// way to send the same reminder twice.
  renewalReminderFor DateTime?
  /// Whether a personal page may appear in search results. Off by default:
  /// most people do not want an AI page about themselves ranking for their own
  /// name. Business pages are always indexed, so this is read only for personal
  /// pages -- see shouldIndex in @curios/core.
  allowSearchIndexing Boolean @default(false)
  /// Soft is the default look; High contrast is the owner's alternative.
  style       PageStyle   @default(SOFT)
  /// #rrggbb, validated by isHexColor before it is written.
  accentColor String      @default("#2340c8")
  headingFont HeadingFont @default(JAKARTA)
  /// The object key of the uploaded picture in storage. Null is no picture.
  avatarKey   String?
  createdAt     DateTime       @default(now())
  links         Link[]
  facts         Fact[]
  topics        Topic[]
  faqRedirects  FaqRedirect[]
  neverSay      NeverSay[]
  conversations Conversation[]
  ingestions    Ingestion[]
  usageCounters UsageCounter[]

  @@unique([accountId])
  leads         Lead[]
  questions     Question[]
  payments      Payment[]
}

model Link {
  id       String @id @default(cuid())
  pageId   String
  page     Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label    String
  url      String
  icon     String?
  position Int
  /// Null is "automatic": arrangeTiles in @curios/core/bento decides from the
  /// tile's position.
  size     TileSize?

  @@index([pageId, position])
}

model Fact {
  id              String       @id @default(cuid())
  pageId          String
  page            Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category        FactCategory
  claim           String
  question        String?
  normalizedClaim String
  sourceUrl       String?
  sourceText      String?
  confidence      Float
  verified        Boolean      @default(false)
  volatile        Boolean      @default(false)
  flagged         Boolean      @default(false)
  rejectedAt      DateTime?
  /// The ingestion that wrote this fact. SetNull, not Cascade: a rejected
  /// fact must outlive its source, because its normalizedClaim is what stops
  /// the next crawl re-asking. Null for OWNER and UNTRACKED facts.
  ingestionId     String?
  ingestion       Ingestion?   @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  origin          FactOrigin   @default(EXTRACTED)
  createdAt       DateTime     @default(now())
  embedding       FactEmbedding?

  @@unique([pageId, normalizedClaim])
  @@index([pageId, category])
  @@index([ingestionId])
}

/// One vector per fact, written by syncFactEmbeddings and read per question.
///
/// Its own table rather than columns on Fact, so re-embedding never rewrites
/// a fact row and no ordinary read of a fact drags two kilobytes of vector
/// along with it. `model` and `dims` are stored on every row because a vector
/// is only meaningful to the embedder that produced it: the chat path reads
/// only rows matching the embedder it holds, so a model change puts pages in
/// fallback rather than scoring against vectors from two different spaces.
model FactEmbedding {
  factId    String   @id
  fact      Fact     @relation(fields: [factId], references: [id], onDelete: Cascade)
  vector    Bytes
  model     String
  dims      Int
  createdAt DateTime @default(now())
}

/// The vector for a question somebody already asked, anywhere in the product.
///
/// Question text is page-independent, so one row serves every page ever asked
/// the same thing. It is a cache of a pure function and needs no invalidation:
/// a row whose model or width does not match the current embedder is ignored
/// and overwritten.
///
/// Keyed by a SHA-256 of the normalised text, never by the text. A follow-up
/// embeds the previous turn together with the question, which can exceed
/// Postgres' ~2,700-byte btree key limit and would throw on a visitor's
/// question in production. The hash is also why this table cannot become a
/// log of what every visitor in the product has ever asked.
///
/// It has no foreign key to anything, so `TRUNCATE "Account" CASCADE` does not
/// clear it. Anything that writes rows here in a test or a harness removes them
/// itself.
model QuestionEmbedding {
  key       String   @id
  vector    Bytes
  model     String
  dims      Int
  createdAt DateTime @default(now())
}

model NeverSay {
  id      String @id @default(cuid())
  pageId  String
  page    Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  phrase  String

  @@index([pageId])
}

model Conversation {
  id        String    @id @default(cuid())
  pageId    String
  page      Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  referrer  String?
  createdAt DateTime  @default(now())
  messages  Message[]
  lead      Lead?

  @@index([pageId, createdAt])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citedFactIds   String[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UsageCounter {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  period String
  count  Int    @default(0)

  @@unique([pageId, period])
}

model Ingestion {
  id             String          @id @default(cuid())
  pageId         String
  page           Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The page crawled. Null when the owner pasted text instead.
  sourceUrl      String?
  /// What the owner pasted. Null when a URL was crawled. Not called
  /// sourceText: Fact.sourceText already exists and means the excerpt one fact
  /// came from, which is a different thing.
  pastedText     String?
  status         IngestionStatus @default(QUEUED)
  extractedCount Int             @default(0)
  error          String?
  /// False for ingestions that ran before slice 14. Their facts are UNTRACKED,
  /// so the Sources tab cannot count them and removing the row removes only
  /// the row.
  tracked        Boolean         @default(true)
  facts          Fact[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([pageId, createdAt])
}

model ModelCall {
  id               String   @id @default(cuid())
  pageId           String?
  conversationId   String?
  ingestionId      String?
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMilliCents   Int
  priceVersion     String
  latencyMs        Int
  ok               Boolean
  errorCode        String?
  createdAt        DateTime @default(now())

  @@index([pageId, createdAt])
}

/// The id is a SHA-256 of the cookie value, never the value itself. A database
/// leak therefore yields no usable session, for the same reason a password is
/// never stored in the clear.
model Session {
  id         String   @id
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// Its own table rather than a column on AuthIdentity, which is read on every
/// Google sign-in. A secret in a routinely-selected row is a leak waiting for a
/// careless select or a logged object.
model PasswordCredential {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, hashed at rest exactly as sessions are.
model AuthToken {
  id        String        @id
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId, kind])
  @@index([expiresAt])
}

model Lead {
  id             String       @id @default(cuid())
  pageId         String
  page           Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Unique, not merely indexed. BACKEND.md's "one capture attempt per
  // conversation" is an invariant, and an invariant the database enforces
  // cannot be skipped by a code path somebody adds later.
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// E.164, one stored form. normalizeMalaysianPhone in packages/core owns that form.
  phone          String
  /// { product, date, location }, filled by the extraction job. Null until it runs.
  slots          Json?
  /// How many slots are filled. A number an owner can verify by looking, not a model opinion.
  score          Int          @default(0)
  status         LeadStatus   @default(NEW)
  createdAt      DateTime     @default(now())

  @@index([pageId, createdAt])
  // The 24-hour dedupe reads this. It cannot be a unique index, because the
  // rule has a time window and an index does not.
  @@index([pageId, phone, createdAt])
}

model Question {
  id                 String   @id @default(cuid())
  pageId             String
  page               Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The first phrasing seen, kept verbatim so the owner reads what a customer typed.
  text               String
  /// normalizeClaim(text). The key a repeat of this wording is recognised by.
  normalizedQuestion String
  askCount           Int      @default(1)
  /// The topic this wording belongs to. Every wording has exactly one.
  topicId            String
  topic              Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// Null until the grouping job has decided where this wording belongs.
  groupedAt          DateTime?
  /// Set when the owner split this wording out. The grouping job never moves it.
  pinnedByOwner      Boolean  @default(false)
  firstAskedAt       DateTime @default(now())
  lastAskedAt        DateTime @default(now())

  @@unique([pageId, normalizedQuestion])
  @@index([topicId])
  // The screen's only ordering: most asked first, then most recent.
  @@index([pageId, askCount])
}

/// One thing visitors ask, in however many wordings. Owns the single pinned
/// answer, the FAQ slug and the combined count. Aggregates are recomputed from
/// its wordings by refreshTopic (packages/db/src/topics.ts), never incremented.
model Topic {
  id              String        @id @default(cuid())
  pageId          String
  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title           String
  titleSetByOwner Boolean       @default(false)
  answer          String?
  answeredAt      DateTime?
  /// Only the one-off grouping sets this: the answer that lost a merge of two
  /// answered topics, kept so the owner can pick.
  conflictAnswer  String?
  askCount        Int           @default(0)
  /// Never changed or cleared once set; retired into FaqRedirect on merge/delete.
  faqSlug         String?
  faqSuppressed   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  lastAskedAt     DateTime      @default(now())
  questions       Question[]
  redirects       FaqRedirect[]

  @@unique([pageId, faqSlug])
  @@index([pageId, askCount])
}

/// A retired FAQ slug. With a topic, the address 301s to that topic's page;
/// with none (the topic was deleted), it 404s -- and is never reissued.
model FaqRedirect {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug    String
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([pageId, slug])
}

model Payment {
  id                  String        @id @default(cuid())
  pageId              String
  /// Restrict, not Cascade like every other table here: a payment is a financial
  /// record, and it must not disappear as a side effect of removing a page.
  page                Page          @relation(fields: [pageId], references: [id], onDelete: Restrict)
  plan                BillingPlan
  /// What was billed, fixed at creation. A grant is checked against this -- never
  /// against today's price, which may have changed since the bill was raised.
  amountCents         Int
  /// Fixed at creation for the same reason, so a later change of collection cannot
  /// break the grant for a bill already issued.
  billplzCollectionId String
  /// Filled from Billplz's response. Unique, so one bill can never grant twice;
  /// nullable, because a failed call to Billplz leaves a pending row without one.
  billplzBillId       String?       @unique
  status              PaymentStatus @default(PENDING)
  paidAt              DateTime?
  /// The paidUntil this payment produced -- an audit trail for every extension.
  grantedUntil        DateTime?
  createdAt           DateTime      @default(now())

  // The hourly pending check scans by status and age.
  @@index([status, createdAt])
  // Plan 2's "recent payments" reads by page, newest first.
  @@index([pageId, createdAt])
}
