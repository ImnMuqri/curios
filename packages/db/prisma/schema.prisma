generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PageMode {
  PERSONAL
  BUSINESS
}

enum AuthProvider {
  GOOGLE
}

enum FactCategory {
  PRICE
  HOURS
  LOCATION
  POLICY
  PRODUCT
  PERSON
  MISC
}

enum IngestionStatus {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
}

/// Who a fact came from. EXTRACTED facts belong to the Ingestion that wrote
/// them and go when it is removed. OWNER facts were typed or edited by the
/// owner and survive any source's removal. UNTRACKED facts predate slice 14,
/// when no fact recorded its ingestion; they are removed one at a time.
enum FactOrigin {
  EXTRACTED
  OWNER
  UNTRACKED
}

enum MessageRole {
  USER
  ASSISTANT
}

enum LeadStatus {
  NEW
  CONTACTED
  /// It became a sale. Apart from CLOSED, because a lead is often only an
  /// enquiry: answered, or a no, and done with.
  SOLD
  CLOSED
}

enum AuthTokenKind {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BillingPlan {
  MONTHLY
  ANNUAL
}

enum PaymentStatus {
  PENDING
  PAID
  /// The gateway refused or cancelled the payment.
  FAILED
  /// The checkout was never completed and the gateway let it lapse.
  EXPIRED
}

/// Which gateway took (or will take) the money. Billplz rows are kept as history
/// after the move to CHIP, so the provider is recorded rather than assumed.
enum PaymentProvider {
  BILLPLZ
  CHIP
}

enum TileSize {
  SMALL
  WIDE
  TALL
  BIG
}

enum PageStyle {
  SOFT
  CONTRAST
}

/// The page's background band, from the palette. PAPER is the look every page had before there was a choice.
enum PageBackground {
  PAPER
  MUDA
  KUNING
  BIRU
  INK
  /// The owner's own colour, in Page.backgroundColor.
  CUSTOM
}

enum HeadingFont {
  JAKARTA
  BRICOLAGE
  FRAUNCES
  SPACE_GROTESK
  DM_SERIF
  OUTFIT
}

/// Where an order stands. Owner transitions are conditional on the current
/// status, so a double tap changes nothing the second time.
enum OrderStatus {
  PLACED
  PAID
  COMPLETED
  CANCELLED
}

/// How a PAID order came to be paid: the owner marked it after checking a
/// receipt the customer uploaded, marked it with no receipt (paid some other
/// way), or CHIP confirmed an online payment on the owner's own account.
enum OrderPaidVia {
  RECEIPT
  MANUAL
  CHIP
}

/// Whether the customer collects or is sent the order.
enum OrderMethod {
  PICKUP
  DELIVERY
}

/// How a shop hands over an order. FLAT adds Page.deliveryFeeCents to the
/// total; RIDER means the customer pays the rider (Lalamove, Grab) directly,
/// so the fee is never part of what the shop charges.
enum DeliveryMode {
  NONE
  FLAT
  RIDER
}

model Account {
  id              String              @id @default(cuid())
  email           String              @unique
  name            String?
  emailVerifiedAt DateTime?
  createdAt       DateTime            @default(now())
  identities      AuthIdentity[]
  pages           Page[]
  sessions        Session[]
  password        PasswordCredential?
  authTokens      AuthToken[]
}

model AuthIdentity {
  id             String       @id @default(cuid())
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  provider       AuthProvider
  providerUserId String
  email          String
  createdAt      DateTime     @default(now())

  @@unique([provider, providerUserId])
  @@index([accountId])
}

model Page {
  id                  String         @id @default(cuid())
  accountId           String
  account             Account        @relation(fields: [accountId], references: [id], onDelete: Cascade)
  handle              String         @unique
  skeleton            String         @unique
  mode                PageMode       @default(BUSINESS)
  displayName         String
  bio                 String?
  language            String         @default("en")
  published           Boolean        @default(false)
  /// Paid through this instant. Null means never paid. A one-off CHIP purchase
  /// extends it or, with auto-renew, a saved card charged by the renewal job
  /// does; there is no subscription to activate, suspend or reconcile, because
  /// each payment simply moves this date. Lapsed is a comparison.
  paidUntil           DateTime?
  /// Leads ever captured, and never decremented. A counter rather than
  /// count(Lead) because slice 5 gave owners a lead delete -- counting rows
  /// would let somebody delete their three trial leads and get three more.
  leadsCaptured       Int            @default(0)
  /// When the owner spent their one trial reset. Null means unused, and the
  /// reset's conditional update requires null -- so a second click changes no
  /// rows rather than granting a second trial.
  trialResetAt        DateTime?
  /// The paidUntil this owner was last reminded about. Renewing moves paidUntil,
  /// which makes the next period eligible by itself: no reminders table, and no
  /// way to send the same reminder twice.
  renewalReminderFor  DateTime?
  /// Whether the owner is emailed each lead (Settings, "Email me when"). On by
  /// default: a lead nobody hears about is the one thing this product exists
  /// to prevent.
  notifyLeads         Boolean        @default(true)
  /// The paidUntil the owner was last told had ended, the on-the-day sibling
  /// of renewalReminderFor and claimed the same way.
  planEndedMailFor    DateTime?
  /// Whether a personal page may appear in search results. Off by default:
  /// most people do not want an AI page about themselves ranking for their own
  /// name. Business pages are always indexed, so this is read only for personal
  /// pages -- see shouldIndex in @curios/core.
  allowSearchIndexing Boolean        @default(false)
  /// Soft is the default look; High contrast is the owner's alternative.
  style               PageStyle      @default(SOFT)
  /// #rrggbb, validated by isHexColor before it is written.
  accentColor         String         @default("#2340c8")
  headingFont         HeadingFont    @default(JAKARTA)
  /// The object key of the uploaded picture in storage. Null is no picture.
  avatarKey           String?
  /// The cover photo: `stock/<name>` for one that ships with Curios, otherwise an object key in storage. Null is no cover.
  coverKey            String?
  background          PageBackground @default(PAPER)
  /// Six-digit hex, used when background is CUSTOM. Kept when the owner picks a
  /// band, so switching back to Custom finds their colour again.
  backgroundColor     String?
  /// Social profiles shown as icons under the name: { instagram, whatsapp, tiktok, email, facebook, youtube }, each a handle. @curios/core/socials reads and writes it.
  socials             Json           @default("{}")
  /// The shop. Off until the owner opens it, and it can only be opened with a
  /// way to pay and a way to hand over -- storeGaps in @curios/core/store.
  storeEnabled        Boolean        @default(false)
  /// "About your shop": shown above the items, before the notice.
  shopDescription     String?
  /// The owner's statement that the shop sells halal food, shown on the
  /// shop and product pages. Shop-wide, not per item.
  shopHalal           Boolean        @default(false)
  pickupEnabled       Boolean        @default(false)
  /// Where pickup happens, as the owner wants it said: "Seksyen 7, Shah Alam".
  pickupNote          String?
  deliveryMode        DeliveryMode   @default(NONE)
  /// Sen. Set only while deliveryMode is FLAT.
  deliveryFeeCents    Int?
  minNoticeDays       Int            @default(1)
  /// The owner's DuitNow QR, an object key in storage.
  paymentQrKey        String?
  bankName            String?
  bankAccountName     String?
  /// Digits only -- normalizeBankAccountNumber.
  bankAccountNumber   String?
  /// The shop tile's index among the page's tiles. Clamped on read by
  /// withShopTile, so a stale value after links are removed still shows it.
  shopTilePosition    Int            @default(0)
  /// Null is automatic, as Link.size is.
  shopTileSize        TileSize?
  /// Orders ever placed, and never decremented: the order number's source and
  /// the trial allowance's count. A counter rather than count(Order) so an
  /// owner cannot delete trial orders to get more, as with leadsCaptured.
  ordersPlaced        Int            @default(0)
  /// ordersPlaced as it stood when the owner spent their trial reset, so the
  /// allowance counts only orders since. Zero until then.
  ordersAtTrialReset  Int            @default(0)
  /// Weekdays the shop does not hand over on, 0 (Sunday) to 6 (Saturday).
  /// Checkout skips them when it offers a day.
  closedDays          Int[]          @default([])
  /// Words about delivery the owner wants the customer to read at checkout:
  /// "Shah Alam only, rider after 5pm". The fee itself is deliveryFeeCents.
  deliveryNote        String?
  /// Whether the owner is emailed each order, the sibling of notifyLeads. On by
  /// default: an order nobody hears about is a customer left waiting.
  notifyOrders        Boolean        @default(true)
  /// Whether the owner is emailed when a receipt comes in, so Mark paid is not
  /// left until they next open the dashboard.
  notifyReceipts      Boolean        @default(true)
  createdAt           DateTime       @default(now())
  links               Link[]
  items               Item[]
  facts               Fact[]
  topics              Topic[]
  faqRedirects        FaqRedirect[]
  neverSay            NeverSay[]
  conversations       Conversation[]
  ingestions          Ingestion[]
  usageCounters       UsageCounter[]
  leads               Lead[]
  questions           Question[]
  payments            Payment[]
  renewalCard         RenewalCard?
  paymentAccount      ShopPaymentAccount?
  orders              Order[]

  @@unique([accountId])
}

model Link {
  id       String    @id @default(cuid())
  pageId   String
  page     Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  label    String
  url      String
  icon     String?
  position Int
  /// Null is "automatic": arrangeTiles in @curios/core/bento decides from the
  /// tile's position.
  size     TileSize?

  @@index([pageId, position])
}

/// Something a business page sells. Either priceCents or at least one
/// ItemOption, never both -- pricingProblem in @curios/core/store, checked by
/// the API on every write.
model Item {
  id          String       @id @default(cuid())
  pageId      String
  page        Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  name        String
  /// The item's link word, made from the name when it is created and frozen
  /// after, so a shared link survives a rename. Unique per page; itemSlug in
  /// @curios/core/slug makes it.
  slug        String
  description String?
  /// Free text the owner types, trimmed; null when blank. The shop groups by it.
  category    String?
  /// One short word on the card (Best seller, Pre-order, New, or the owner's
  /// own), at most ITEM_TAG_MAX characters; null when blank.
  tag         String?
  /// An object key in storage, like Page.avatarKey.
  photoKey    String?
  priceCents  Int?
  /// Off hides it from the shop and from the chat.
  available   Boolean      @default(true)
  position    Int
  createdAt   DateTime     @default(now())
  options     ItemOption[]
  orderLines  OrderLine[]

  @@unique([pageId, slug])
  @@index([pageId, position])
}

model ItemOption {
  id         String @id @default(cuid())
  itemId     String
  item       Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)
  label      String
  priceCents Int
  position   Int

  @@index([itemId, position])
}

model Fact {
  id              String         @id @default(cuid())
  pageId          String
  page            Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  category        FactCategory
  claim           String
  question        String?
  normalizedClaim String
  sourceUrl       String?
  sourceText      String?
  /// Up to a sentence of the source just before and just after sourceText,
  /// so Review can show the excerpt picked out of its line. Null when the
  /// excerpt could not be found in the source, and for facts read before this.
  sourceBefore    String?
  sourceAfter     String?
  confidence      Float
  verified        Boolean        @default(false)
  volatile        Boolean        @default(false)
  flagged         Boolean        @default(false)
  rejectedAt      DateTime?
  /// The ingestion that wrote this fact. SetNull, not Cascade: a rejected
  /// fact must outlive its source, because its normalizedClaim is what stops
  /// the next crawl re-asking. Null for OWNER and UNTRACKED facts.
  ingestionId     String?
  ingestion       Ingestion?     @relation(fields: [ingestionId], references: [id], onDelete: SetNull)
  origin          FactOrigin     @default(EXTRACTED)
  createdAt       DateTime       @default(now())
  embedding       FactEmbedding?

  @@unique([pageId, normalizedClaim])
  @@index([pageId, category])
  @@index([ingestionId])
}

/// One vector per fact, written by syncFactEmbeddings and read per question.
///
/// Its own table rather than columns on Fact, so re-embedding never rewrites
/// a fact row and no ordinary read of a fact drags two kilobytes of vector
/// along with it. `model` and `dims` are stored on every row because a vector
/// is only meaningful to the embedder that produced it: the chat path reads
/// only rows matching the embedder it holds, so a model change puts pages in
/// fallback rather than scoring against vectors from two different spaces.
model FactEmbedding {
  factId    String   @id
  fact      Fact     @relation(fields: [factId], references: [id], onDelete: Cascade)
  vector    Bytes
  model     String
  dims      Int
  createdAt DateTime @default(now())
}

/// The vector for a question somebody already asked, anywhere in the product.
///
/// Question text is page-independent, so one row serves every page ever asked
/// the same thing. It is a cache of a pure function and needs no invalidation:
/// a row whose model or width does not match the current embedder is ignored
/// and overwritten.
///
/// Keyed by a SHA-256 of the normalised text, never by the text. A follow-up
/// embeds the previous turn together with the question, which can exceed
/// Postgres' ~2,700-byte btree key limit and would throw on a visitor's
/// question in production. The hash is also why this table cannot become a
/// log of what every visitor in the product has ever asked.
///
/// It has no foreign key to anything, so `TRUNCATE "Account" CASCADE` does not
/// clear it. Anything that writes rows here in a test or a harness removes them
/// itself.
model QuestionEmbedding {
  key       String   @id
  vector    Bytes
  model     String
  dims      Int
  createdAt DateTime @default(now())
}

model NeverSay {
  id     String @id @default(cuid())
  pageId String
  page   Page   @relation(fields: [pageId], references: [id], onDelete: Cascade)
  phrase String

  @@index([pageId])
}

model Conversation {
  id             String    @id @default(cuid())
  pageId         String
  page           Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  referrer       String?
  createdAt      DateTime  @default(now())
  messages       Message[]
  lead           Lead?
  /// The order this chat is waiting on, set while a customer asks about it. The
  /// chat looks it up by this rather than by guessing from the transcript.
  /// SetNull: the order going must not take the conversation with it.
  pendingOrderId String?
  pendingOrder   Order?    @relation(fields: [pendingOrderId], references: [id], onDelete: SetNull)

  @@index([pageId, createdAt])
  // Deleting an order sets this null (SetNull): without it, every order the
  // retention sweep deletes scans Conversation.
  @@index([pendingOrderId])
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           MessageRole
  content        String
  citedFactIds   String[]
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
}

model UsageCounter {
  id          String    @id @default(cuid())
  pageId      String
  page        Page      @relation(fields: [pageId], references: [id], onDelete: Cascade)
  period      String
  count       Int       @default(0)
  /// When "Your page reached its monthly limit" went out for this period.
  /// One counter row per month, so null-then-set is once a month by itself.
  capMailedAt DateTime?

  @@unique([pageId, period])
}

model Ingestion {
  id             String          @id @default(cuid())
  pageId         String
  page           Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The page crawled. Null when the owner pasted text instead.
  sourceUrl      String?
  /// What the owner pasted. Null when a URL was crawled. Not called
  /// sourceText: Fact.sourceText already exists and means the excerpt one fact
  /// came from, which is a different thing.
  pastedText     String?
  /// The uploaded file this text was read from (a resume PDF, a Word menu), when
  /// the owner sent a file rather than pasting. Its text is in pastedText; the
  /// file itself is never kept.
  fileName       String?
  status         IngestionStatus @default(QUEUED)
  extractedCount Int             @default(0)
  /// How far through its source the read has got, 0 to 100: where the latest
  /// fact's excerpt sits in the text, so the bar moves as the source is read.
  progress       Int             @default(0)
  error          String?
  /// False for ingestions that ran before slice 14. Their facts are UNTRACKED,
  /// so the Sources tab cannot count them and removing the row removes only
  /// the row.
  tracked        Boolean         @default(true)
  facts          Fact[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([pageId, createdAt])
}

model ModelCall {
  id               String   @id @default(cuid())
  pageId           String?
  conversationId   String?
  ingestionId      String?
  model            String
  inputTokens      Int
  outputTokens     Int
  cacheReadTokens  Int      @default(0)
  cacheWriteTokens Int      @default(0)
  costMilliCents   Int
  priceVersion     String
  latencyMs        Int
  ok               Boolean
  errorCode        String?
  createdAt        DateTime @default(now())

  @@index([pageId, createdAt])
}

/// The id is a SHA-256 of the cookie value, never the value itself. A database
/// leak therefore yields no usable session, for the same reason a password is
/// never stored in the clear.
model Session {
  id         String   @id
  accountId  String
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  lastSeenAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([accountId])
  @@index([expiresAt])
}

/// Its own table rather than a column on AuthIdentity, which is read on every
/// Google sign-in. A secret in a routinely-selected row is a leak waiting for a
/// careless select or a logged object.
model PasswordCredential {
  id        String   @id @default(cuid())
  accountId String   @unique
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  hash      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// Single-use, hashed at rest exactly as sessions are.
model AuthToken {
  id        String        @id
  accountId String
  account   Account       @relation(fields: [accountId], references: [id], onDelete: Cascade)
  kind      AuthTokenKind
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([accountId, kind])
  @@index([expiresAt])
}

model Lead {
  id             String       @id @default(cuid())
  pageId         String
  page           Page         @relation(fields: [pageId], references: [id], onDelete: Cascade)
  // Unique, not merely indexed. BACKEND.md's "one capture attempt per
  // conversation" is an invariant, and an invariant the database enforces
  // cannot be skipped by a code path somebody adds later.
  conversationId String       @unique
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  /// E.164, one stored form. normalizeMalaysianPhone in packages/core owns that form.
  phone          String
  /// { product, date, location }, filled by the extraction job. Null until it runs.
  slots          Json?
  /// How many slots are filled. A number an owner can verify by looking, not a model opinion.
  score          Int          @default(0)
  status         LeadStatus   @default(NEW)
  createdAt      DateTime     @default(now())

  @@index([pageId, createdAt])
  // The 24-hour dedupe reads this. It cannot be a unique index, because the
  // rule has a time window and an index does not.
  @@index([pageId, phone, createdAt])
}

model Question {
  id                 String        @id @default(cuid())
  pageId             String
  page               Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The first phrasing seen, kept verbatim so the owner reads what a customer typed.
  text               String
  /// normalizeClaim(text). The key a repeat of this wording is recognised by.
  normalizedQuestion String
  askCount           Int           @default(1)
  /// The topic this wording belongs to. Every wording has exactly one.
  topicId            String
  topic              Topic         @relation(fields: [topicId], references: [id], onDelete: Cascade)
  /// Null until the grouping job has decided where this wording belongs.
  groupedAt          DateTime?
  /// Set when the owner split this wording out. The grouping job never moves it.
  pinnedByOwner      Boolean       @default(false)
  firstAskedAt       DateTime      @default(now())
  lastAskedAt        DateTime      @default(now())
  asks               QuestionAsk[]

  @@unique([pageId, normalizedQuestion])
  @@index([topicId])
  // The screen's only ordering: most asked first, then most recent.
  @@index([pageId, askCount])
}

/// One thing visitors ask, in however many wordings. Owns the single pinned
/// answer, the FAQ slug and the combined count. Aggregates are recomputed from
/// its wordings by refreshTopic (packages/db/src/topics.ts), never incremented.
/// One row each time a wording is asked, for the Questions screen's week of
/// asks. Follows its wording through a merge or split; goes with it on delete.
/// Asks before this table existed are only in Question.askCount.
model QuestionAsk {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  askedAt    DateTime @default(now())
  /// Whether the chat could answer it: true from the owner's answer or the
  /// facts, false when it said it was not sure. Null before this was
  /// recorded, and for the month's fixed reply, which is not an answer either way.
  answered   Boolean?

  @@index([questionId, askedAt])
}

model Topic {
  id              String        @id @default(cuid())
  pageId          String
  page            Page          @relation(fields: [pageId], references: [id], onDelete: Cascade)
  title           String
  titleSetByOwner Boolean       @default(false)
  answer          String?
  answeredAt      DateTime?
  /// Only the one-off grouping sets this: the answer that lost a merge of two
  /// answered topics, kept so the owner can pick.
  conflictAnswer  String?
  askCount        Int           @default(0)
  /// Never changed or cleared once set; retired into FaqRedirect on merge/delete.
  faqSlug         String?
  faqSuppressed   Boolean       @default(false)
  createdAt       DateTime      @default(now())
  lastAskedAt     DateTime      @default(now())
  questions       Question[]
  redirects       FaqRedirect[]

  @@unique([pageId, faqSlug])
  @@index([pageId, askCount])
}

/// A retired FAQ slug. With a topic, the address 301s to that topic's page;
/// with none (the topic was deleted), it 404s -- and is never reissued.
model FaqRedirect {
  id      String  @id @default(cuid())
  pageId  String
  page    Page    @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slug    String
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)

  @@unique([pageId, slug])
}

model Payment {
  id                  String          @id @default(cuid())
  pageId              String
  /// Restrict, not Cascade like every other table here: a payment is a financial
  /// record, and it must not disappear as a side effect of removing a page.
  page                Page            @relation(fields: [pageId], references: [id], onDelete: Restrict)
  plan                BillingPlan
  /// What was billed, fixed at creation. A grant is checked against this -- never
  /// against today's price, which may have changed since the bill was raised.
  amountCents         Int
  provider            PaymentProvider @default(CHIP)
  /// Billplz only: fixed at creation so a later change of collection cannot break
  /// the grant for a bill already issued. Null for CHIP payments.
  billplzCollectionId String?
  /// The provider's id for this payment (Billplz bill id or CHIP purchase id).
  /// Unique, so one purchase can never grant twice; nullable, because a failed
  /// call to the provider leaves a pending row without one.
  providerRef         String?         @unique
  /// The buyer asked for their card to be kept and charged again at renewal.
  autoRenew           Boolean         @default(false)
  /// This payment is itself a renewal charge made by the job, not a checkout.
  autoRenewal         Boolean         @default(false)
  status              PaymentStatus   @default(PENDING)
  paidAt              DateTime?
  /// The paidUntil this payment produced -- an audit trail for every extension.
  grantedUntil        DateTime?
  createdAt           DateTime        @default(now())

  // The hourly pending check scans by status and age.
  @@index([status, createdAt])
  // Plan 2's "recent payments" reads by page, newest first.
  @@index([pageId, createdAt])
}

/// A card CHIP saved for a page's auto-renew. One per page: a new card replaces
/// the old. Cascades with the page, unlike Payment, because it is a credential
/// handle and not a financial record.
/// A shop's own payment account: the owner's CHIP brand and secret key, so
/// customers pay the owner directly. One per page. The secret key is stored
/// only sealed (packages/core/src/secret-box.ts), and this table is never part
/// of a page select; the web app's read-only role cannot read that column at
/// all (packages/db/prisma/sql/readonly-role.sql).
model ShopPaymentAccount {
  pageId              String          @id
  page                Page            @relation(fields: [pageId], references: [id], onDelete: Cascade)
  provider            PaymentProvider @default(CHIP)
  brandId             String
  /// From CHIP when it says (a purchase's issuer details); null until then.
  brandName           String?
  /// sealSecret(secret key, PAYMENT_SECRETS_KEY), base64.
  secretKeyCiphertext String
  /// The owner's CHIP public key, from GET /public_key/: what verifies their callbacks.
  publicKeyPem        String
  /// The method names GET /payment_methods/ listed when the key was last checked.
  methods             String[]
  /// A test key: no real money moves. Learned from a purchase's is_test; false until one says.
  isTest              Boolean         @default(false)
  connectedAt         DateTime        @default(now())
  checkedAt           DateTime
  /// When a call with this key was last refused by CHIP.
  lastErrorAt         DateTime?
}

model RenewalCard {
  pageId         String      @id
  page           Page        @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// CHIP's recurring token; what the renewal job charges.
  token          String      @unique
  plan           BillingPlan
  cardLabel      String?
  failedAttempts Int         @default(0)
  lastFailedAt   DateTime?
  lastAttemptAt  DateTime?
  createdAt      DateTime    @default(now())
}

/// One customer's order from a business page's shop. Money is sen, computed by
/// the server; the lines below are copies, so a later edit to an Item cannot
/// rewrite what was sold.
model Order {
  id                String         @id @default(cuid())
  pageId            String
  page              Page           @relation(fields: [pageId], references: [id], onDelete: Cascade)
  /// The page's own running number, from Page.ordersPlaced. What the owner
  /// sees as #12.
  number            Int
  /// Four characters, unique per page. What a customer says to the chat; never
  /// a secret on its own, since the chat also asks the last 4 phone digits.
  code              String
  /// hashSessionValue of the order link's secret. Only the hash is stored, so
  /// a database read cannot open anybody's order page.
  tokenHash         String         @unique
  customerName      String
  /// E.164, as Lead.phone is.
  phone             String
  method            OrderMethod
  /// The calendar day (Malaysia) of pickup or delivery.
  day               DateTime       @db.Date
  /// Set only for DELIVERY.
  address           String?
  note              String?
  /// Sen. The three are stored, not derived, so the order shows what the
  /// customer was told even if the delivery fee changes later.
  itemsCents        Int
  deliveryCents     Int
  totalCents        Int
  /// The uploaded receipt, an object key under receipts/<pageId>/. Null until
  /// the customer sends one.
  receiptKey        String?
  /// Its content type, sniffed from the first bytes, never the client's word.
  receiptType       String?
  receiptUploadedAt DateTime?
  /// When the owner said "Not received": the receipt is cleared (receiptKey and
  /// receiptType go null) and this time is set, so the order page can ask the
  /// customer to pay and upload again.
  receiptRejectedAt DateTime?
  status            OrderStatus    @default(PLACED)
  paidAt            DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  /// When the owner marked the money returned after a paid order was
  /// cancelled. Null with CANCELLED and paidAt set is a refund still owed.
  refundedAt        DateTime?
  /// How it was paid; null until it is. Orders paid before this column existed stay null.
  paidVia           OrderPaidVia?
  /// The CHIP purchase that pays (or paid) this order online, on the owner's own account.
  chipPurchaseId    String?        @unique
  /// The customer's email, asked for only when they pay online (CHIP needs one for the receipt).
  payerEmail        String?
  /// How CHIP says it was paid, for the order page: "FPX · Maybank2u".
  paidMethodLabel   String?
  /// CHIP's reference for the payment, shown beside it.
  paidRef           String?
  createdAt         DateTime       @default(now())
  lines             OrderLine[]
  conversations     Conversation[]

  @@unique([pageId, number])
  @@unique([pageId, code])
  @@index([pageId, createdAt])
}

model OrderLine {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  /// SetNull: deleting an Item must not delete the history of selling it.
  itemId         String?
  item           Item?   @relation(fields: [itemId], references: [id], onDelete: SetNull)
  /// The name and price at the time of the order, copied for the same reason.
  itemName       String
  optionLabel    String?
  unitPriceCents Int
  quantity       Int
  position       Int

  @@index([orderId, position])
  // Deleting an item sets this null (SetNull): without it, every deleted item scans OrderLine.
  @@index([itemId])
}
