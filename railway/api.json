{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.server",
    "watchPatterns": [
      "apps/api/**",
      "packages/**",
      "scripts/prepare-database.ts",
      "pnpm-lock.yaml",
      "Dockerfile.server"
    ]
  },
  "deploy": {
    "startCommand": "node --import tsx apps/api/src/server.ts",
    "preDeployCommand": "node --import tsx scripts/prepare-database.ts",
    "healthcheckPath": "/health",
    "healthcheckTimeout": 120,
    "drainingSeconds": 30,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 5
  }
}
