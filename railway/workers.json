{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "Dockerfile.server",
    "watchPatterns": [
      "apps/workers/**",
      "packages/**",
      "pnpm-lock.yaml",
      "Dockerfile.server"
    ]
  },
  "deploy": {
    "startCommand": "node --import tsx apps/workers/src/main.ts",
    "drainingSeconds": 60,
    "restartPolicyType": "ALWAYS"
  }
}
